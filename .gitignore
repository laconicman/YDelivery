.DS_Store
.build
/Packages
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm
.netrc
.vscode
.ci/
.cursorignore

# Credentials. The package's live suites read AUTH_TOKEN from the environment and the token
# lives outside any repository (~/.yandex-auth-token, mode 600). These patterns exist so a
# copy made "just for a minute" cannot be committed by accident.
*.token
*auth-token*
*-token
.env
.env.*
secrets.*
*.pem
*.p12

# The project file is generated: project.yml is the source of truth (TechDebt → YD-4),
# so the pbxproj and the generated scheme leave version control — run `xcodegen generate`
# after cloning or editing the spec.
YDelivery.xcodeproj/project.pbxproj
YDelivery.xcodeproj/xcshareddata/xcschemes/

# NOT ignored, deliberately, and it differs from the sibling package:
#   Package.resolved — an app pins its dependencies; a library lets consumers resolve their
#                      own. See the workspace CLAUDE.md.
.thumbnail
