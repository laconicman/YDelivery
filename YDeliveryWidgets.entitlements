<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The extension's only entitlement: the shared container, where the app's
     `AppDatabase` already lives. No iCloud entitlement — the extension never
     starts the sync engine; the app owns the CloudKit side. -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.learnable.YDelivery</string>
	</array>
</dict>
</plist>
