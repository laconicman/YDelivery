DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE attachmentBlobs (
        "___createTime"                                     TIMESTAMP,
        "___createdBy"                                      REFERENCE,
        "___etag"                                           STRING,
        "___modTime"                                        TIMESTAMP,
        "___modifiedBy"                                     REFERENCE,
        "___recordID"                                       REFERENCE,
        attachmentID                                        ENCRYPTED STRING,
        data                                                ASSET,
        data_hash                                           ENCRYPTED BYTES,
        sqlitedata_icloud_userModificationTime              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_attachmentID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_data         ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE customFieldDefinitions (
        "___createTime"                                         TIMESTAMP,
        "___createdBy"                                          REFERENCE,
        "___etag"                                               STRING,
        "___modTime"                                            TIMESTAMP,
        "___modifiedBy"                                         REFERENCE,
        "___recordID"                                           REFERENCE,
        carrier                                                 ENCRYPTED STRING,
        choicesJSON                                             ENCRYPTED STRING,
        id                                                      ENCRYPTED STRING,
        isOptional                                              ENCRYPTED INT64,
        isShownByDefault                                        ENCRYPTED INT64,
        kind                                                    ENCRYPTED STRING,
        name                                                    ENCRYPTED STRING,
        position                                                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime                  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_carrier          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_choicesJSON      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id               ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_isOptional       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_isShownByDefault ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_name             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_position         ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE memberships (
        "___createTime"                                     TIMESTAMP,
        "___createdBy"                                      REFERENCE,
        "___etag"                                           STRING,
        "___modTime"                                        TIMESTAMP,
        "___modifiedBy"                                     REFERENCE,
        "___recordID"                                       REFERENCE,
        addedAt                                             ENCRYPTED DOUBLE,
        authorRef                                           ENCRYPTED STRING,
        id                                                  ENCRYPTED STRING,
        orderID                                             ENCRYPTED STRING,
        partyRef                                            ENCRYPTED STRING,
        role                                                ENCRYPTED STRING,
        signature                                           ENCRYPTED STRING,
        signingKeyID                                        ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_addedAt      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorRef    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_partyRef     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_role         ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signature    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signingKeyID ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderAttachments (
        "___createTime"                                     TIMESTAMP,
        "___createdBy"                                      REFERENCE,
        "___etag"                                           STRING,
        "___modTime"                                        TIMESTAMP,
        "___modifiedBy"                                     REFERENCE,
        "___recordID"                                       REFERENCE,
        authorHint                                          ENCRYPTED STRING,
        authorRef                                           ENCRYPTED STRING,
        byteSize                                            ENCRYPTED INT64,
        caption                                             ENCRYPTED STRING,
        createdAt                                           ENCRYPTED DOUBLE,
        dataHash                                            ENCRYPTED STRING,
        id                                                  ENCRYPTED STRING,
        kind                                                ENCRYPTED STRING,
        orderID                                             ENCRYPTED STRING,
        signature                                           ENCRYPTED STRING,
        signingKeyID                                        ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorHint   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorRef    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_byteSize     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_caption      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_createdAt    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dataHash     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind         ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signature    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signingKeyID ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderCustomFields (
        "___createTime"                                 TIMESTAMP,
        "___createdBy"                                  REFERENCE,
        "___etag"                                       STRING,
        "___modTime"                                    TIMESTAMP,
        "___modifiedBy"                                 REFERENCE,
        "___recordID"                                   REFERENCE,
        carrier                                         ENCRYPTED STRING,
        fieldRef                                        ENCRYPTED STRING,
        id                                              ENCRYPTED STRING,
        name                                            ENCRYPTED STRING,
        orderID                                         ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_carrier  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_fieldRef ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_name     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_value    ENCRYPTED INT64,
        value                                           ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderEvents (
        "___createTime"                                         TIMESTAMP,
        "___createdBy"                                          REFERENCE,
        "___etag"                                               STRING,
        "___modTime"                                            TIMESTAMP,
        "___modifiedBy"                                         REFERENCE,
        "___recordID"                                           REFERENCE,
        at                                                      ENCRYPTED DOUBLE,
        authorRef                                               ENCRYPTED STRING,
        detail                                                  ENCRYPTED STRING,
        id                                                      ENCRYPTED STRING,
        kind                                                    ENCRYPTED STRING,
        legRef                                                  ENCRYPTED STRING,
        orderID                                                 ENCRYPTED STRING,
        providerEventID                                         ENCRYPTED INT64,
        providerRevision                                        ENCRYPTED INT64,
        providerStatus                                          ENCRYPTED STRING,
