        "___modTime"                                              TIMESTAMP,
        "___modifiedBy"                                           REFERENCE,
        "___recordID"                                             REFERENCE,
        archivedAt                                                ENCRYPTED DOUBLE,
        lastSeenActivityAt                                        ENCRYPTED DOUBLE,
        orderID                                                   ENCRYPTED STRING,
        personalNote                                              ENCRYPTED STRING,
        pinned                                                    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime                    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_archivedAt         ENCRYPTED INT64,
