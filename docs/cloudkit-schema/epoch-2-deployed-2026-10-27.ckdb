        signature                                               ENCRYPTED STRING,
        signingKeyID                                            ENCRYPTED STRING,
        source                                                  ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime                  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_at               ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorRef        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_detail           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id               ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_legRef           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_providerEventID  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_providerRevision ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_providerStatus   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_routeDigest      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signature        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signingKeyID     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_source           ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderItems (
        "___createTime"                                       TIMESTAMP,
        "___createdBy"                                        REFERENCE,
        "___etag"                                             STRING,
        "___modTime"                                          TIMESTAMP,
        "___modifiedBy"                                       REFERENCE,
        "___recordID"                                         REFERENCE,
        cost                                                  ENCRYPTED STRING,
        currency                                              ENCRYPTED STRING,
        dropoffStopRef                                        ENCRYPTED STRING,
        id                                                    ENCRYPTED STRING,
        name                                                  ENCRYPTED STRING,
        orderID                                               ENCRYPTED STRING,
        pickupStopRef                                         ENCRYPTED STRING,
        quantity                                              ENCRYPTED INT64,
        sizeHeightCm                                          ENCRYPTED DOUBLE,
        sizeLengthCm                                          ENCRYPTED DOUBLE,
        sizeWidthCm                                           ENCRYPTED DOUBLE,
        sqlitedata_icloud_userModificationTime                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_cost           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_currency       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dropoffStopRef ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_name           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_pickupStopRef  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_quantity       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sizeHeightCm   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sizeLengthCm   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sizeWidthCm    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_weightKg       ENCRYPTED INT64,
        weightKg                                              ENCRYPTED DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderMessages (
        "___createTime"                                      TIMESTAMP,
        "___createdBy"                                       REFERENCE,
        "___etag"                                            STRING,
        "___modTime"                                         TIMESTAMP,
        "___modifiedBy"                                      REFERENCE,
        "___recordID"                                        REFERENCE,
        attachmentRef                                        ENCRYPTED STRING,
        authorHint                                           ENCRYPTED STRING,
        authorRef                                            ENCRYPTED STRING,
        id                                                   ENCRYPTED STRING,
        kind                                                 ENCRYPTED STRING,
        orderID                                              ENCRYPTED STRING,
        sentAt                                               ENCRYPTED DOUBLE,
        signature                                            ENCRYPTED STRING,
        signingKeyID                                         ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime               ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_attachmentRef ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorHint    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorRef     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sentAt        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signature     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_signingKeyID  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_text          ENCRYPTED INT64,
        text                                                 ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderOptions (
        "___createTime"                                   TIMESTAMP,
        "___createdBy"                                    REFERENCE,
        "___etag"                                         STRING,
        "___modTime"                                      TIMESTAMP,
        "___modifiedBy"                                   REFERENCE,
        "___recordID"                                     REFERENCE,
        comment                                           ENCRYPTED STRING,
        due                                               ENCRYPTED DOUBLE,
        loaders                                           ENCRYPTED INT64,
        orderID                                           ENCRYPTED STRING,
        proCourier                                        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_comment    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_due        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_loaders    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_orderID    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_proCourier ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_thermobag  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_toDoor     ENCRYPTED INT64,
        thermobag                                         ENCRYPTED INT64,
        toDoor                                            ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE orderPrivateStates (
        "___createTime"                                           TIMESTAMP,
        "___createdBy"                                            REFERENCE,
